# Local test environment (PCL instances, logs, natives, reports)
# 注意：baritone-maven/ 曾经被整目录忽略，导致任何 clone 仓库的人
# 都构建不了内嵌了 Baritone 的工程（本地仓库里没有依赖）。
# 现在改为用 scripts/install-baritone.ps1 从官方 Release 按校验值拉取，
# 目录本身仍然不入库（积压产物可达数百 MB）。
.test/
baritone-maven/
fabric/baritone-maven/

# Stale porting artifacts and baritone tool workspaces
_porting_stale/
_tools/

# Local smoke-test scratch space (launch logs, javap dumps, audit output)
_smoke/
scripts/__pycache__/

# Wallpaper Engine reverse-engineering scratch space (extracted scene art and
# the probe scripts); the findings live in docs/wallpaper-engine-scene.md
.recon/

# Minecraft runtime config written when the client is launched from the repo root
/config/

# Agent tool state (the tool dirs keep their own .gitignore as well)
.reasonix/
reasonix.toml
