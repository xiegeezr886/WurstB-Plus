# ============================================================================
# WurstB+ Plus — repository ignore rules
#
# Policy for JARs: ignore everything, then explicitly re-include the jars that
# are genuine BUILD INPUTS. A fresh clone must be able to run `gradlew build`
# in every one of the 67 projects without first running a helper script.
#
# IMPORTANT: never exclude a parent DIRECTORY that contains a re-included file
# (e.g. do NOT write `fabric/baritone-maven/`) — git cannot re-include a file
# whose parent directory is excluded. Exclude files/globs only.
# ============================================================================

# Gradle
.gradle/
build/
.gradle-compose-cache/
.kotlin/

# IDE
.idea/
*.iml
.vscode/
.settings/
.metadata
.classpath
.project
bin/
out/

# OS
.DS_Store
Thumbs.db

# Runtime
run/
runs/
run-data/
logs/
*.log

# ---------------------------------------------------------------------------
# JARs: ignored by default, re-included only where they are build inputs.
# ---------------------------------------------------------------------------
*.jar

# Gradle wrapper — must exist in all 67 projects.
!gradle/wrapper/gradle-wrapper.jar
!**/gradle/wrapper/gradle-wrapper.jar

# Baritone: the runtime dependency every project needs to compile.
# Root repo (used by the root project and neoforge/ via flatDir).
!/baritone-api-forge-*.jar
# Checked-in local Maven repositories.
!baritone-maven/**/*.jar
!fabric/baritone-maven/**/*.jar
# Project-local flatDir jars.
!versions/*/libs/*.jar
!fabric/libs/*.jar
!fabric/versions/*/libs/*.jar
!neoforge/versions/*/libs/*.jar
!baritone-api-forge-*.jar

# Keep the noisy local-only backups out of the checked-in Maven repo.
baritone-maven/**/*.rejected/**
baritone-maven/**/*.pre-26.2-compat
baritone-maven/**/*.bak-JAVA25
baritone-maven/**/*.disabled
fabric/baritone-maven/**/*.rejected/**
fabric/baritone-maven/**/*.pre-26.2-compat
fabric/baritone-maven/**/*.bak-JAVA25
fabric/baritone-maven/**/*.disabled

# ---------------------------------------------------------------------------
# native/ffmpeg — LGPL-2.1 "corresponding source" provision.
#
# The build scripts, licence texts and the JNI shim source MUST be tracked:
# the mod ships FFmpeg DLLs, and LGPL-2.1 requires the corresponding source to
# be available to whoever receives the binary. Only the compiled `dll/`
# output is ignored (the runtime copies that actually ship live in
# src/main/resources/assets/wurst/ffmpeg/ and are tracked).
# ---------------------------------------------------------------------------
native/ffmpeg/dll/

# ---------------------------------------------------------------------------
# reference/ — local-only reference material (NOT build inputs).
#
# Everything the audits used to leave loose in the repository root now lives
# under a single top-level `reference/` tree, so the root stays readable:
#
#   reference/upstream-sources/   other clients' source trees and archives
#   reference/clients/            open-source/recovered client sources kept
#                                 together for cross-reference (see its README)
#   reference/decompiled/         Mojang / Forge bytecode dumps
#   reference/vendor/             third-party config and profile dumps
#   reference/artifacts/          unpacked build outputs from these tools
#   reference/tools/              baritone source trees, ad-hoc tooling
#   reference/recon/              reverse-engineering evidence
#   reference/errreport/          crash dumps and bug reports
#   reference/porting-stale/      superseded porting artefacts
#   reference/smoke/              client smoke-test scratch space
#
# Provenance, licence status and "safe to delete?" for every one of these is
# documented in docs/REPO-HYGIENE.md. Read it before redistributing anything.
# ---------------------------------------------------------------------------
/reference/

# Arbitrary downloaded archives.
*.zip
download/
hs_err_pid*.log
compile_errors.txt
compile-errors-index.txt
build_log*.txt
baritone-checksums.txt
GameRenderer_bytecode.txt
*.tmp
*.bak
*.orig
*.rej

# Local test environment (PCL instances, logs, natives, reports)
.test/

# Stale porting artifacts, baritone tool workspaces and smoke-test scratch
# space used to live here; they are now under reference/ (see above).

scripts/__pycache__/
__pycache__/

# Reverse-engineering scratch space — Wallpaper Engine (findings live in
# docs/wallpaper-engine-scene.md). Moved to reference/recon-wallpaper/ and is
# covered by the `/reference/` rule above; kept here as a note only.

# Vendored / dumped reference material — now under reference/ (see above).
# `free0810/`, `official/`, `wurstb_profiles/`, `_errreport/` and `forge-mdk/`
# used to be listed here individually; they moved into reference/ and are
# covered by the `/reference/` rule. The old `source_archives/` rule was dead
# (the directory never existed) and has been dropped.

# Minecraft runtime config written when the client is launched from the repo root
/config/

# Agent tool state (the tool dirs keep their own .gitignore as well)
.reasonix/
reasonix.toml
.claude/settings.local.json

# Third-party repositories cloned into the workspace root for reference only.
# They are independent git repositories and must NOT be tracked by this one.
/InfiniteGUI-Minecraft-DLL/
/Lunar-Local-Cosmetics-Unlocker/
/LumaGlass/

# Retired ignore rules kept only as a record — the paths no longer exist:
#   gradle/gradle/   accidental duplicate wrapper directory (deleted)
#   /libs/           empty stray directory (deleted)
#   /baritone-api-forge-1.20_or_1.20.1.jar   never referenced by any build
