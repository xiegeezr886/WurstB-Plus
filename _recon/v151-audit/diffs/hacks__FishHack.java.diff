+package net.wurstclient.hacks;
+
+import net.minecraft.client.player.LocalPlayer;
+import net.minecraft.world.phys.Vec3;
+import net.wurstclient.Category;
+import net.wurstclient.SearchTags;
+import net.wurstclient.events.UpdateListener;
+import net.wurstclient.hack.Hack;
+
+@SearchTags({"AutoSwim", "auto swim"})
+public final class FishHack extends Hack implements UpdateListener
+{
+	public FishHack()
+	{
+		super("Fish");
+		setCategory(Category.MOVEMENT);
+	}
+	
+	@Override
+	protected void onEnable()
+	{
+		EVENTS.add(UpdateListener.class, this);
+		WURST.getHax().dolphinHack.setEnabled(false);
+	}
+	
+	@Override
+	protected void onDisable()
+	{
+		EVENTS.remove(UpdateListener.class, this);
+	}
+	
+	@Override
+	public void onUpdate()
+	{
+		LocalPlayer player = MC.player;
+		if(!player.isInWater() || player.isShiftKeyDown())
+			return;
+		
+		Vec3 velocity = player.getDeltaMovement();
+		player.setDeltaMovement(velocity.x, velocity.y + 0.005, velocity.z);
+	}
+}
