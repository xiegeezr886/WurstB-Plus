+	
+	public static AABB enclosing(BlockPos pos1, BlockPos pos2)
+	{
+		return new AABB(Math.min(pos1.getX(), pos2.getX()),
+			Math.min(pos1.getY(), pos2.getY()),
+			Math.min(pos1.getZ(), pos2.getZ()),
